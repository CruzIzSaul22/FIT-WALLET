<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FITFINAL.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FITFINAL.Views">

    <ShellContent
        Title="Inicio"
        Route="home"
        ContentTemplate="{DataTemplate views:HomePage}" />

    <ShellContent
        Title="Registrar"
        Route="register"
        ContentTemplate="{DataTemplate views:RegisterPage}" />

    <ShellContent
        Title="Metas"
        Route="goals"
        ContentTemplate="{DataTemplate views:GoalsPage}" />

    <ShellContent
        Title="Reportes"
        Route="reports"
        ContentTemplate="{DataTemplate views:ReportsPage}" />

</Shell>
