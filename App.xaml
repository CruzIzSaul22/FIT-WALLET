<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FITFINAL.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:FITFINAL.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Converters -->
            <converters:TypeToColorConverter x:Key="TypeToColorConverter" />
            <converters:TypeToBoolConverter x:Key="TypeToBoolConverter" />
            <converters:ProgressConverter x:Key="ProgressConverter" />

            <!-- Colores tema claro -->
            <Color x:Key="PrimaryColor">#2E7D32</Color>
            <!-- Verde medio -->
            <Color x:Key="PrimaryLight">#A5D6A7</Color>
            <!-- Verde claro (header) -->
            <Color x:Key="AccentColor">#388E3C</Color>
            <!-- Verde para énfasis -->
            <Color x:Key="DangerColor">#E53935</Color>
            <!-- Rojo para gastos -->
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <!-- Tarjetas blancas -->
            <Color x:Key="PageBackground">#FFFFFF</Color>
            <!-- Fondo de página blanco -->
            <Color x:Key="TextPrimary">#212121</Color>
            <!-- Texto principal oscuro -->
            <Color x:Key="TextSecondary">#757575</Color>
            <!-- Texto secundario -->

            <!-- Estilo global para Label -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <!-- Estilo global para Button -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>